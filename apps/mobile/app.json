{
  "expo": {
    "name": "QueueLess",
    "slug": "queueless",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "queueless",
    "splash": {
      "backgroundColor": "#2563eb"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.queueless.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563eb"
      },
      "package": "com.queueless.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "QueueLess needs your location to find nearby hospitals."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
